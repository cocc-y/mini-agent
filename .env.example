# Mini Agent 环境配置
# 复制为 .env 后填写。兼容任意 OpenAI 格式的 Chat Completions 接口。

# 必须：API Key（替换成你自己的 Key）
LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY

# 接口地址（OpenAI 兼容）
#   DeepSeek:  https://api.deepseek.com/v1
#   OpenAI:    https://api.openai.com/v1
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   其他国内中转/自建服务请填对应地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
#   DeepSeek:  deepseek-chat
#   OpenAI:    gpt-4o-mini
LLM_MODEL=deepseek-chat

# ---- 工具相关（可选）----
# Tavily 搜索 API Key（https://tavily.com）
#TAVILY_API_KEY=tvly-xxxx
# SerpAPI 搜索 API Key（https://serpapi.com）
#SERPAPI_API_KEY=xxxx
# 说明：两者配置其一即可让 search 工具使用真实网络搜索；
# 都不配置时自动降级为本地 mock 知识库。

# 采样温度（可选）
LLM_TEMPERATURE=0.5

# 单次请求超时（秒，可选）
LLM_TIMEOUT=60

# 单个用户请求内允许的最大工具迭代轮数（可选，默认 6）
MAX_ROUNDS=6

# 完整保留的历史消息条数，超出部分将被压缩为摘要（可选，默认 16）
MAX_HISTORY_MESSAGES=16

SERPAPI_API_KEY=
TAVILY_API_KEY=